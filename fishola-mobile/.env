VITE__API_DEFAULT_PORT=8080
VITE__ENV_NAME=dev
# Visualiseur PDF intégré désactivé en dev (npm run serve) ; la carte de pêche
# s'ouvre alors par le bouton « Ouvrir le PDF » (#331). Les builds web, mobile
# et démo l'activent (.env.web, .env.mobile, .env.demo).
VITE__REMOVE_PDF_VIEWER=true
VITE__FORCED_DEVICE_TYPE=application
VITE__SCALE_SAMPLING_ENABLED=false
